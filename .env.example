# Web3Forms access key — vygeneruje se na https://web3forms.com/ zadáním
# cílové e-mailové adresy (daniela.vranova@seznam.cz). Klíč je vázaný na tu
# adresu, submitnutí formuláře chodí přímo tam.
# Zkopírovat do .env.local (lokálně) a do proměnných prostředí hostingu.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# URL skriptu konkrétního webu z Plausible > Site Settings > Site Installation,
# např. https://plausible.io/js/pa-XXXXX.js. Měření běží jen na hlavní doméně.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
